# Required
DATABASE_URL=postgres://user:pass@localhost:5432/nava
JWT_SECRET=change-me-to-a-long-random-string
# Optional
PORT=3000
UPLOAD_DIR=./uploads
# Set to true only if your Postgres requires SSL (e.g. a public proxy URL)
PGSSL=false
# Optional TURN server for voice/video behind strict NATs
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
# Password of the built-in admin account "Nava". If empty, a random one is generated on first boot and printed once in the logs.
ADMIN_PASSWORD=
